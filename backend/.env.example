# HireNext Backend Environment Configuration
# Copy this file to .env and adjust values for your local setup.
# Never commit the real .env file.

DATABASE_URL=postgresql://postgres:password@localhost:5432/hirenext

# Comma-separated list of allowed CORS origins (frontend dev servers).
# LOCAL_ORIGINS=http://localhost:5173,http://localhost:5176

# Directory where uploaded resume PDFs are stored locally.
UPLOAD_DIR=uploads

# Optional port override for running the API (defaults to 8000).
# PORT=8000
</content>
